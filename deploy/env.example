# ==============================================================================
# ARGUS — Environment Configuration Template
# ==============================================================================

# 1. CORE APPLICATION & ENVIRONMENT
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# 2. CRYPTOGRAPHIC KEYS & SECURITY
# 32-byte hex key for AES-256-GCM encryption in the PII Vault
ARGUS_VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret salt for format-preserving, session-scoped tokenization
ARGUS_TOKENIZER_SALT=argus-secure-session-salt-change-in-production
# JWT secret for API Gateway auth and Maker-Checker digital signatures
JWT_SECRET_KEY=argus-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Ed25519 seed for Agent-to-Agent (A2A) cryptographic signatures
AGENT_MESH_SIGNING_SEED=argus-agent-mesh-ed25519-seed-phrase

# 3. POSTGRESQL & PGVECTOR
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus_user
POSTGRES_PASSWORD=argus_password_local
POSTGRES_VAULT_USER=argus_vault_user
POSTGRES_VAULT_PASSWORD=argus_vault_password_local

# 4. REDIS (CACHE & RATE LIMITING)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 5. OPEN POLICY AGENT (OPA)
OPA_URL=http://localhost:8181
OPA_POLICY_BUNDLE_DIR=./policies

# 6. LLM RUNTIME & EMBEDDINGS
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_API_KEY=
OPENAI_API_KEY=

# 7. DOCUMENT STORAGE
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=argus-regulations

# 8. OBSERVABILITY
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
