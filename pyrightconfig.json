{
  "include": [
    "contracts",
    "services",
    "tests",
    "scripts",
    "redteam",
    "ui"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "venv"
  ],
  "extraPaths": [
    ".",
    "contracts",
    "services",
    "ui"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
